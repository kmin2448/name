# 픽사베이 배경 이미지 검색용 API 키
# https://pixabay.com/api/docs/ 에서 무료 발급 (계정 로그인 후 페이지에 표시됨)
# 로컬: 이 파일을 .env.local로 복사해 값 입력
# 배포: Vercel → Settings → Environment Variables에 추가
PIXABAY_API_KEY=

# 페이지 접속 수(오늘/전체) 저장용 Supabase 연결 정보
# Supabase 프로젝트 → Settings → API 에서 확인
# 서버(Route Handler)에서만 사용하므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── 구글 로그인 (내 명단 저장 기능) ─────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
#   → "OAuth 클라이언트 ID 만들기" → 웹 애플리케이션
# 승인된 리디렉션 URI에 아래 두 개를 등록
#   http://localhost:3000/api/auth/callback/google
#   https://<배포도메인>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 세션 쿠키 서명 키 — `openssl rand -base64 32`로 생성
NEXTAUTH_SECRET=
# 배포 도메인 (로컬 개발에서는 생략 가능)
NEXTAUTH_URL=

# ── 명단 저장용 구글 시트 ──────────────────────────────────────────
# 위 OAuth 클라이언트와는 별개로 "서비스 계정"을 따로 만든다
#   사용자 인증 정보 → "서비스 계정 만들기" → 키 → 키 추가 → JSON
# 만들어진 서비스 계정 이메일(...iam.gserviceaccount.com)을
# 시트 공유 대화상자에서 "편집자"로 추가하고, 링크 공유는 "제한됨"으로 바꿀 것
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON 키의 private_key 값을 그대로 붙여넣는다 (\n 이스케이프 포함)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 시트 탭 이름을 바꿨을 때만 지정 (비우면 첫 번째 탭 사용)
GOOGLE_SHEETS_TAB_NAME=

# ── 명패 디자인 저장용 구글 시트 ───────────────────────────────────
# 배경·오버레이 이미지의 배치값과 텍스트 서식이 저장되는 시트
# (이미지 파일 자체는 로그인한 사용자 본인의 구글 드라이브에 저장된다)
GOOGLE_DESIGN_SHEETS_ID=
GOOGLE_DESIGN_SHEETS_TAB_NAME=

# ── 검색 노출(SEO) ────────────────────────────────────────────────
# 배포 주소. 사이트맵·robots.txt·og:url에 쓰인다.
# 비우면 Vercel이 넣어 주는 주소를, 그것도 없으면 기본값을 쓴다.
NEXT_PUBLIC_SITE_URL=

# 검색엔진 소유 확인 코드. 등록 과정에서 받은 값을 넣으면
# 별도 파일을 올리지 않아도 메타 태그로 확인이 끝난다.
# 구글: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버: https://searchadvisor.naver.com
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
